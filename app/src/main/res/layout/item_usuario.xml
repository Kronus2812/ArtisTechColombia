<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de usuario: avatar con iniciales, datos, rol, estado y acciones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/relleno_tarjeta">

        <TextView
            android:id="@+id/tvIniciales"
            android:layout_width="@dimen/avatar_pequeno"
            android:layout_height="@dimen/avatar_pequeno"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo"
            android:textColor="@color/blanco"
            android:textSize="@dimen/texto_cuerpo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRol"
                    style="@style/Widget.ArtisTech.Insignia"
                    android:backgroundTint="@color/arena"
                    android:textColor="@color/cafe_texto" />

                <TextView
                    android:id="@+id/tvEstado"
                    style="@style/Widget.ArtisTech.Insignia"
                    android:layout_marginStart="@dimen/espacio_xs" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditar"
            style="@style/Widget.ArtisTech.IconoAccion"
            android:contentDescription="@string/cd_editar"
            android:src="@drawable/ic_editar" />

        <ImageButton
            android:id="@+id/btnEliminar"
            style="@style/Widget.ArtisTech.IconoAccion"
            android:contentDescription="@string/cd_eliminar"
            android:src="@drawable/ic_eliminar" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
