<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado del menú lateral del Administrador. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_splash"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_xxl"
    android:paddingEnd="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <TextView
        android:id="@+id/tvIniciales"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circulo_translucido"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ArtisTech.Titulo"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
        android:textColor="@color/blanco_85" />

    <TextView
        style="@style/Widget.ArtisTech.Insignia"
        android:layout_marginTop="@dimen/espacio_s"
        android:backgroundTint="@color/blanco_30"
        android:text="@string/rol_admin"
        android:textColor="@color/blanco" />
</LinearLayout>
