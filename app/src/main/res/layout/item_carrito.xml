<?xml version="1.0" encoding="utf-8"?>
<!-- Ítem del carrito: miniatura, datos, selector de cantidad y eliminar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/relleno_tarjeta">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/miniatura"
            android:layout_height="@dimen/miniatura"
            app:cardCornerRadius="@dimen/radio_imagen"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/contenedorImagen"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="@dimen/icono_mediano"
                    android:layout_height="@dimen/icono_mediano"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/blanco_70" />

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_foto_producto"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

            <TextView
                android:id="@+id/tvVendedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

            <TextView
                android:id="@+id/tvPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:textAppearance="@style/TextAppearance.ArtisTech.Precio"
                android:textSize="@dimen/texto_cuerpo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEliminar"
                style="@style/Widget.ArtisTech.IconoAccion"
                android:layout_width="@dimen/boton_cantidad_grande"
                android:layout_height="@dimen/boton_cantidad_grande"
                android:padding="@dimen/espacio_compacto"
                android:contentDescription="@string/cd_eliminar"
                android:src="@drawable/ic_eliminar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/alto_selector_cantidad"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMenos"
                    style="@style/Widget.ArtisTech.IconoAccion"
                    android:layout_width="@dimen/boton_cantidad"
                    android:layout_height="@dimen/boton_cantidad"
                    android:padding="@dimen/espacio_compacto"
                    android:contentDescription="@string/cd_restar"
                    android:src="@drawable/ic_restar"
                    app:tint="@color/terracota" />

                <TextView
                    android:id="@+id/tvCantidad"
                    android:layout_width="@dimen/icono_m"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Etiqueta"
                    android:textColor="@color/cafe_texto"
                    android:textSize="@dimen/texto_chip" />

                <ImageButton
                    android:id="@+id/btnMas"
                    style="@style/Widget.ArtisTech.IconoAccion"
                    android:layout_width="@dimen/boton_cantidad"
                    android:layout_height="@dimen/boton_cantidad"
                    android:padding="@dimen/espacio_compacto"
                    android:contentDescription="@string/cd_sumar"
                    android:src="@drawable/ic_agregar"
                    app:tint="@color/terracota" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
