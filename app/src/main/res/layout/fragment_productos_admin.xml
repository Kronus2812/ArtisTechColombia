<?xml version="1.0" encoding="utf-8"?>
<!-- Gestión de productos del Administrador: moderación del catálogo (aprobar, rechazar, editar, eliminar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.ArtisTech.Contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_m">

                <TextView
                    style="@style/Widget.ArtisTech.EtiquetaKpi"
                    android:text="@string/kpi_total_productos" />

                <TextView
                    android:id="@+id/tvKpiTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Kpi" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/mostaza_claro"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_m">

                <TextView
                    style="@style/Widget.ArtisTech.EtiquetaKpi"
                    android:text="@string/kpi_revision"
                    android:textColor="@color/mostaza_oscuro" />

                <TextView
                    android:id="@+id/tvKpiRevision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Kpi"
                    android:textColor="@color/mostaza_oscuro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/verde_selva_claro"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_m">

                <TextView
                    style="@style/Widget.ArtisTech.EtiquetaKpi"
                    android:text="@string/kpi_publicados"
                    android:textColor="@color/verde_selva" />

                <TextView
                    android:id="@+id/tvKpiPublicados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Kpi"
                    android:textColor="@color/verde_selva" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipRevision"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRevision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_revision" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPublicados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_publicados" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAgotados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_agotados" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRechazados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_rechazados" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_xs"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:text="@string/admin_productos_ayuda"
        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_s"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/admin_productos_vacio"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
