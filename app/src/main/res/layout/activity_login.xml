<?xml version="1.0" encoding="utf-8"?>
<!-- Autenticación: correo/contraseña, acceso con huella (BiometricPrompt) y accesos de demostración. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.ArtisTech.Contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/espacio_xxl"
        android:paddingBottom="@dimen/espacio_xl">

        <FrameLayout
            android:layout_width="@dimen/logo_login"
            android:layout_height="@dimen/logo_login"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="@dimen/boton_icono"
                android:layout_height="@dimen/boton_icono"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_logo_marca" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/login_titulo"
            android:textAppearance="@style/TextAppearance.ArtisTech.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:layout_marginBottom="@dimen/espacio_xl"
            android:text="@string/login_subtitulo"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
            android:textSize="@dimen/texto_cuerpo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/campo_email"
            app:startIconDrawable="@drawable/ic_correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/campo_clave"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_candado">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvOlvido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/espacio_xs"
            android:text="@string/login_olvido"
            android:textAppearance="@style/TextAppearance.ArtisTech.Etiqueta"
            android:textColor="@color/terracota"
            android:textSize="@dimen/texto_secundario" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/login_ingresar" />

        <!-- Tarjeta de acceso biométrico -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHuella"
            style="@style/Widget.ArtisTech.Card.Destacada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_l">

                <ImageView
                    android:layout_width="@dimen/icono_l"
                    android:layout_height="@dimen/icono_l"
                    android:contentDescription="@string/cd_huella"
                    android:src="@drawable/ic_huella"
                    app:tint="@color/terracota" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_huella"
                        android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo"
                        android:textSize="@dimen/texto_cuerpo" />

                    <TextView
                        android:id="@+id/tvHuellaDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_huella_inactiva"
                        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/login_demo"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDemoComprador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rol_comprador" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDemoVendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rol_vendedor" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDemoAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rol_admin" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_sin_cuenta"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                style="@style/Widget.ArtisTech.Button.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_registrate" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:gravity="center"
            android:text="@string/legal_habeas_data"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
            android:textSize="@dimen/texto_etiqueta" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
