<?xml version="1.0" encoding="utf-8"?>
<!-- Gestión de usuarios (Administrador): listado, búsqueda, filtro por rol y creación con FAB. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Widget.ArtisTech.Contenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConteo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:layout_marginBottom="0dp"
                android:hint="@string/usuarios_buscar"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_buscar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipTodos"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompradores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_compradores" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVendedores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_vendedores" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdmins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_admins" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsuarios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_s"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espacio_l"
        android:contentDescription="@string/usuarios_nuevo"
        android:src="@drawable/ic_agregar" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
