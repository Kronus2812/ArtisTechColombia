<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo: búsqueda en tiempo real, filtro por categoría (chips) y cuadrícula de productos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_l">

    <LinearLayout
        style="@style/Widget.ArtisTech.Contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalogo_titulo"
            android:textAppearance="@style/TextAppearance.ArtisTech.Titulo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:layout_marginBottom="0dp"
            android:hint="@string/catalogo_buscar"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_buscar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipTodos"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTejidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_tejidos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCeramica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_ceramica" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCesteria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_cesteria" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJoyeria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_joyeria" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMadera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_madera" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDiseno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_diseno" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvResultados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_s"
        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/relleno_lista"
            android:paddingEnd="@dimen/relleno_lista"
            android:paddingBottom="@dimen/espacio_l" />

        <LinearLayout
            android:id="@+id/vistaVacia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/espacio_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/miniatura"
                android:layout_height="@dimen/miniatura"
                android:contentDescription="@null"
                android:src="@drawable/ic_buscar"
                app:tint="@color/linea" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:gravity="center"
                android:text="@string/catalogo_vacio"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
