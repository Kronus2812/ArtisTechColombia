<?xml version="1.0" encoding="utf-8"?>
<!-- Panel de productos del Vendedor (CRUD completo). CoordinatorLayout permite el FAB extendido
     que se contrae al desplazar la lista. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Widget.ArtisTech.Contenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_l">

            <TextView
                android:id="@+id/tvTaller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ArtisTech.Titulo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vendedor_panel_subtitulo"
                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

            <!-- Indicadores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1.4"
                    app:cardBackgroundColor="@color/terracota"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_m">

                        <TextView
                            style="@style/Widget.ArtisTech.EtiquetaKpi"
                            android:text="@string/kpi_ventas_mes"
                            android:textColor="@color/blanco_85" />

                        <TextView
                            android:id="@+id/tvKpiVentas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ArtisTech.Kpi"
                            android:textColor="@color/blanco"
                            android:textSize="18sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_m">

                        <TextView
                            style="@style/Widget.ArtisTech.EtiquetaKpi"
                            android:text="@string/kpi_productos" />

                        <TextView
                            android:id="@+id/tvKpiProductos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ArtisTech.Kpi"
                            android:textSize="18sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/mostaza_claro"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_m">

                        <TextView
                            style="@style/Widget.ArtisTech.EtiquetaKpi"
                            android:text="@string/kpi_revision"
                            android:textColor="@color/mostaza_oscuro" />

                        <TextView
                            android:id="@+id/tvKpiRevision"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ArtisTech.Kpi"
                            android:textColor="@color/mostaza_oscuro"
                            android:textSize="18sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:layout_marginBottom="0dp"
                android:hint="@string/vendedor_buscar"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_buscar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipTodos"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPublicados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_publicados" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRevision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_revision" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAgotados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_agotados" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingTop="@dimen/espacio_s"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingBottom="88dp" />

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/vendedor_sin_productos"
                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevo"
        style="@style/Widget.ArtisTech.FabExtendido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espacio_l"
        android:text="@string/vendedor_nuevo_producto"
        app:icon="@drawable/ic_agregar" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
