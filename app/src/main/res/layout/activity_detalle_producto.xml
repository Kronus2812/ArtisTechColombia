<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de producto: ConstraintLayout con contenido desplazable y barra inferior fija de compra. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/barraInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Imagen principal con botones flotantes -->
            <FrameLayout
                android:id="@+id/contenedorImagen"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_imagen_detalle">

                <ImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/blanco_70" />

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_foto_producto"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnAtras"
                    style="@style/Widget.ArtisTech.BotonFlotante"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/espacio_l"
                    android:contentDescription="@string/cd_volver"
                    android:src="@drawable/ic_atras" />

                <ImageButton
                    android:id="@+id/btnFavorito"
                    style="@style/Widget.ArtisTech.BotonFlotante"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/espacio_l"
                    android:contentDescription="@string/cd_favorito"
                    android:src="@drawable/ic_corazon"
                    app:tint="@color/terracota" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ArtisTech.Contenedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/espacio_l"
                android:paddingBottom="@dimen/espacio_l">

                <TextView
                    android:id="@+id/tvCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Titulo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrecio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.ArtisTech.Precio"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvCalificacion"
                        style="@style/Widget.ArtisTech.Insignia"
                        android:backgroundTint="@color/mostaza_claro"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/cafe_texto"
                        app:drawableStartCompat="@drawable/ic_estrella"
                        app:drawableTint="@color/mostaza" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_iva"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

                <!-- Tarjeta del vendedor -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/espacio_m">

                        <TextView
                            android:id="@+id/tvAvatarVendedor"
                            android:layout_width="@dimen/avatar_pequeno"
                            android:layout_height="@dimen/avatar_pequeno"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo"
                            android:textColor="@color/blanco"
                            android:textSize="@dimen/texto_cuerpo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvVendedor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

                            <TextView
                                android:id="@+id/tvRegionVendedor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
                                app:drawableStartCompat="@drawable/ic_ubicacion"
                                app:drawableTint="@color/verde_selva" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/cd_verificado"
                            android:src="@drawable/ic_escudo"
                            app:tint="@color/verde_selva" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Widget.ArtisTech.TituloSeccion"
                    android:text="@string/detalle_descripcion" />

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo"
                    android:textColor="@color/cafe_secundario" />

                <TextView
                    style="@style/Widget.ArtisTech.TituloSeccion"
                    android:text="@string/detalle_ficha" />

                <!-- Ficha técnica con TableLayout -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stepper"
                    android:padding="@dimen/espacio_m"
                    android:stretchColumns="1">

                    <TableRow>
                        <TextView style="@style/Widget.ArtisTech.FilaResumen" android:text="@string/ficha_origen" android:textColor="@color/cafe_secundario" />
                        <TextView android:id="@+id/tvOrigen" style="@style/Widget.ArtisTech.ValorResumen" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/Widget.ArtisTech.FilaResumen" android:text="@string/ficha_tecnica" android:textColor="@color/cafe_secundario" />
                        <TextView android:id="@+id/tvTecnica" style="@style/Widget.ArtisTech.ValorResumen" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/Widget.ArtisTech.FilaResumen" android:text="@string/ficha_elaboracion" android:textColor="@color/cafe_secundario" />
                        <TextView android:id="@+id/tvElaboracion" style="@style/Widget.ArtisTech.ValorResumen" />
                    </TableRow>

                    <TableRow>
                        <TextView style="@style/Widget.ArtisTech.FilaResumen" android:text="@string/ficha_disponibles" android:textColor="@color/cafe_secundario" />
                        <TextView android:id="@+id/tvStock" style="@style/Widget.ArtisTech.ValorResumen" />
                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_l"
                    android:background="@drawable/bg_stepper"
                    android:backgroundTint="@color/verde_selva_claro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_m">

                    <ImageView
                        android:layout_width="@dimen/icono_m"
                        android:layout_height="@dimen/icono_m"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camion"
                        app:tint="@color/verde_selva" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_m"
                        android:layout_weight="1"
                        android:text="@string/detalle_retracto"
                        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
                        android:textColor="@color/verde_selva" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior fija -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alto_boton"
            android:background="@drawable/bg_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenos"
                style="@style/Widget.ArtisTech.IconoAccion"
                android:contentDescription="@string/cd_restar"
                android:src="@drawable/ic_restar"
                app:tint="@color/terracota" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/uno"
                android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo" />

            <ImageButton
                android:id="@+id/btnMas"
                style="@style/Widget.ArtisTech.IconoAccion"
                android:contentDescription="@string/cd_sumar"
                android:src="@drawable/ic_agregar"
                app:tint="@color/terracota" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:layout_weight="1"
            android:text="@string/detalle_agregar"
            app:icon="@drawable/ic_carrito" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
