<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de producto para la cuadrícula del catálogo (RecyclerView + GridLayoutManager). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_compacto"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/contenedorImagen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_imagen_producto">

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="@dimen/icono_xl"
                android:layout_height="@dimen/icono_xl"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/blanco_70" />

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_foto_producto"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCategoria"
                style="@style/Widget.ArtisTech.Insignia"
                android:layout_margin="@dimen/espacio_s"
                android:backgroundTint="@color/blanco_85"
                android:textColor="@color/cafe_texto" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/relleno_tarjeta">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:lines="2"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo"
                android:textSize="@dimen/texto_chip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xxs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icono_xs"
                    android:layout_height="@dimen/icono_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ubicacion"
                    app:tint="@color/verde_selva" />

                <TextView
                    android:id="@+id/tvRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
                    android:textSize="@dimen/texto_etiqueta" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Precio"
                    android:textSize="@dimen/texto_cuerpo" />

                <ImageView
                    android:layout_width="@dimen/icono_mini"
                    android:layout_height="@dimen/icono_mini"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_estrella"
                    app:tint="@color/mostaza" />

                <TextView
                    android:id="@+id/tvCalificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xxs"
                    android:textAppearance="@style/TextAppearance.ArtisTech.Etiqueta"
                    android:textColor="@color/cafe_texto" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
