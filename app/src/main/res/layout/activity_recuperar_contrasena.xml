<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperación de contraseña (RF-04) en dos pasos: correo y código + nueva contraseña. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/recuperar_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            style="@style/Widget.ArtisTech.Contenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/espacio_xl">

            <FrameLayout
                android:layout_width="@dimen/circulo_destacado"
                android:layout_height="@dimen/circulo_destacado"
                android:layout_marginTop="@dimen/espacio_l"
                android:background="@drawable/bg_circulo">

                <ImageView
                    android:layout_width="@dimen/icono_l"
                    android:layout_height="@dimen/icono_l"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_candado"
                    android:src="@drawable/ic_candado"
                    app:tint="@color/terracota" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPaso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:text="@string/recuperar_paso_1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Etiqueta"
                android:textColor="@color/terracota" />

            <TextView
                android:id="@+id/tvInstruccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:layout_marginBottom="@dimen/espacio_xl"
                android:gravity="center"
                android:text="@string/recuperar_instruccion_1"
                android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

            <!-- Paso 1: correo -->
            <LinearLayout
                android:id="@+id/pasoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/campo_email"
                    app:startIconDrawable="@drawable/ic_correo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recuperar_enviar" />
            </LinearLayout>

            <!-- Paso 2: código y nueva contraseña -->
            <LinearLayout
                android:id="@+id/pasoCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/campo_codigo"
                    app:counterEnabled="true"
                    app:counterMaxLength="6">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="6" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNuevaClave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/campo_nueva_clave"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/ayuda_clave"
                    app:startIconDrawable="@drawable/ic_candado">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNuevaClave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/campo_confirmar_clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestablecer"
                    style="@style/Widget.ArtisTech.Button.Verde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recuperar_restablecer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReenviar"
                    style="@style/Widget.ArtisTech.Button.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/recuperar_reenviar" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
