<?xml version="1.0" encoding="utf-8"?>
<!-- Historial de pedidos recibidos por el Vendedor, con filtro por estado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_l">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:text="@string/pedidos_titulo"
        android:textAppearance="@style/TextAppearance.ArtisTech.Titulo" />

    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipTodos"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPorDespachar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_por_despachar" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnTransito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_en_transito" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEntregados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_entregado" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_s"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/pedidos_vacio"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/arena"
        android:gravity="center"
        android:padding="@dimen/espacio_s"
        android:text="@string/pedidos_ayuda"
        android:textAppearance="@style/TextAppearance.ArtisTech.Secundario"
        android:textSize="@dimen/texto_etiqueta" />
</LinearLayout>
