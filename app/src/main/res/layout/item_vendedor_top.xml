<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del ranking de mejores vendedores. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_s">

    <TextView
        android:id="@+id/tvPosicion"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circulo"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ArtisTech.Subtitulo"
        android:textColor="@color/terracota"
        android:textSize="@dimen/texto_cuerpo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textAppearance="@style/TextAppearance.ArtisTech.Cuerpo" />

        <TextView
            android:id="@+id/tvRegion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ArtisTech.Secundario" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.ArtisTech.Precio"
        android:textSize="14sp" />
</LinearLayout>
